<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product template list -->
    <record id="product_template_tree_view_last_purchase" model="ir.ui.view">
        <field name="name">product.template.list.last.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field name="last_purchase_price" widget="monetary"
                       options="{'currency_field': 'cost_currency_id'}"
                       optional="show" groups="purchase.group_purchase_user"/>
                <field name="last_purchase_vendor_id" optional="show"
                       groups="purchase.group_purchase_user"/>
                <field name="last_purchase_date" optional="hide"
                       groups="purchase.group_purchase_user"/>
            </field>
        </field>
    </record>

    <!-- Product variant list -->
    <record id="product_product_tree_view_last_purchase" model="ir.ui.view">
        <field name="name">product.product.list.last.purchase</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="after">
                <field name="last_purchase_price" widget="monetary"
                       options="{'currency_field': 'cost_currency_id'}"
                       optional="show" groups="purchase.group_purchase_user"/>
                <field name="last_purchase_vendor_id" optional="show"
                       groups="purchase.group_purchase_user"/>
                <field name="last_purchase_date" optional="hide"
                       groups="purchase.group_purchase_user"/>
            </field>
        </field>
    </record>

    <!-- Product template form: Purchase tab -->
    <record id="product_template_form_view_last_purchase" model="ir.ui.view">
        <field name="name">product.template.form.last.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit"/>
        <field name="arch" type="xml">
            <group name="purchase" position="before">
                <group name="last_purchase" string="Last Purchase">
                    <group>
                        <field name="last_purchase_price" widget="monetary"
                               options="{'currency_field': 'cost_currency_id'}"/>
                        <field name="last_purchase_vendor_id"/>
                    </group>
                    <group>
                        <field name="last_purchase_date"/>
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
