<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order PDF -->
    <template id="report_purchaseorder_document_sl_no" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_sl_no" class="text-start" style="width: 1%; white-space: nowrap;"><strong>Sl. No.</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_sl_no" class="text-start"><span t-out="line.sl_no"/></td>
        </xpath>
        <!-- Section rows span the columns before the subtotal: one more column now -->
        <xpath expr="//td[@id='section']" position="attributes">
            <attribute name="colspan">6</attribute>
        </xpath>
    </template>

    <!-- Request for Quotation PDF -->
    <template id="report_purchasequotation_document_sl_no" inherit_id="purchase.report_purchasequotation_document">
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_sl_no" class="text-start" style="width: 1%; white-space: nowrap;"><strong>Sl. No.</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td name="td_sl_no" class="text-start"><span t-out="order_line.sl_no"/></td>
        </xpath>
    </template>
</odoo>
