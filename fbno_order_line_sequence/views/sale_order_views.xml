<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_sl_no" model="ir.ui.view">
        <field name="name">sale.order.form.sl.no</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Hide Odoo's own on-screen line counter so numbers are not shown twice -->
            <xpath expr="//field[@name='order_line']/list/widget[@name='line_number']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/widget[@name='line_number']" position="after">
                <field name="sl_no" string="Sl. No." readonly="1" invisible="display_type" width="60px"/>
            </xpath>
        </field>
    </record>
</odoo>
