<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="view_res_config_settings_apps_menu_theme" model="ir.ui.view">
        <field name="name">res.config.settings.apps.menu.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="muk_web_theme.view_res_config_settings_colors_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[field[@name='theme_background_image']]" position="after">
                <setting
                    string="Apps Menu Theme"
                    company_dependent="1"
                    help="Choose a CSS theme or use the custom background image."
                >
                    <field name="apps_menu_theme"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

